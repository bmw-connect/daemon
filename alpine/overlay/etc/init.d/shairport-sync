#!/sbin/openrc-run
# AirPlay receiver — writes into the ALSA loopback (substream 0).
# Config: /etc/shairport-sync.conf (output device "airplay" from /etc/asound.conf).

description="Shairport Sync AirPlay receiver"

supervisor=supervise-daemon
command="/usr/bin/shairport-sync"
command_args="-u"
respawn_delay=3
respawn_max=0

depend() {
    need dbus avahi-daemon
    after modules
}
