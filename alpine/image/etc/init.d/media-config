#!/sbin/openrc-run
# Picks up user-editable config from the FAT boot partition, so the SD card
# can be configured from any computer without booting the Pi:
#   wifi.conf        -> /etc/wpa_supplicant/wpa_supplicant.conf
#   authorized_keys  -> /root/.ssh/authorized_keys

description="Apply user config from the boot media"

MEDIA=/media/mmcblk0p1

depend() {
    need localmount
    before wpa_supplicant networking sshd
}

start() {
    ebegin "Applying config from $MEDIA"
    if [ -f "$MEDIA/wifi.conf" ]; then
        cp "$MEDIA/wifi.conf" /etc/wpa_supplicant/wpa_supplicant.conf
        chmod 600 /etc/wpa_supplicant/wpa_supplicant.conf
    fi
    if [ -f "$MEDIA/authorized_keys" ]; then
        mkdir -p /root/.ssh
        chmod 700 /root/.ssh
        cp "$MEDIA/authorized_keys" /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys
    fi
    eend 0
}

stop() {
    return 0
}
